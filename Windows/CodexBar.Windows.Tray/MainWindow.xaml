<Window
    x:Class="CodexBar.Windows.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CodexBar.Windows.Tray"
    Title="CodexBar"
    Width="520"
    MinHeight="120"
    Opacity="{Binding WindowOpacity}"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource UiFont}"
    Foreground="{DynamicResource PrimaryTextBrush}"
    Icon="/CodexBar.Windows.Tray;component/Assets/CodexBar.ico"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    Topmost="{Binding IsAlwaysOnTop}"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
    WindowStyle="None">
    <Window.Resources>
        <DataTemplate x:Key="RateWindowTemplate" DataType="{x:Type local:RateWindowViewModel}">
            <DockPanel
                Margin="{Binding CellMargin}"
                Background="Transparent"
                ToolTip="{Binding Tooltip}">
                <Grid
                    Margin="{Binding RadialMargin}"
                    HorizontalAlignment="{Binding RadialAlignment}"
                    VerticalAlignment="Center"
                    DockPanel.Dock="{Binding RadialDock}"
                    Visibility="{Binding IsRadial, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <local:UsageMeter
                        Width="{Binding RadialWidth}"
                        Height="{Binding RadialHeight}"
                        FillBrush="{Binding FillBrush}"
                        Kind="{Binding MeterKind}"
                        Thickness="{Binding RadialThickness}"
                        TrackBrush="{Binding TrackBrush}"
                        Value="{Binding DisplayPercent, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="{Binding RadialLabelAlignment}"
                        FontSize="{Binding RadialFontSize}"
                        FontWeight="Bold"
                        Foreground="{Binding PercentBrush}"
                        Text="{Binding PercentLabel}" />
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <DockPanel Margin="0,0,0,5" LastChildFill="False">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{Binding MutedBrush}"
                            Text="{Binding Label}" />
                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding IsLinear, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{Binding PercentBrush}"
                                Text="{Binding PercentLabel}" />
                            <TextBlock
                                Margin="4,0,0,1"
                                VerticalAlignment="Bottom"
                                FontSize="11"
                                Foreground="{Binding MutedBrush}"
                                Text="{Binding PercentCaption}" />
                        </StackPanel>
                        <TextBlock
                            DockPanel.Dock="Right"
                            FontSize="11"
                            Foreground="{Binding MutedBrush}"
                            Text="{Binding PercentCaption}"
                            Visibility="{Binding IsRadial, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </DockPanel>

                    <local:UsageMeter
                        Height="{Binding LinearHeight}"
                        Margin="0,0,0,6"
                        FillBrush="{Binding FillBrush}"
                        Kind="{Binding MeterKind}"
                        Marker="{Binding Marker, Mode=OneWay}"
                        MarkerBrush="{Binding MarkerBrush}"
                        Segments="{Binding Segments}"
                        Thickness="{Binding LinearThickness}"
                        TrackBrush="{Binding TrackBrush}"
                        Value="{Binding DisplayPercent, Mode=OneWay}"
                        Visibility="{Binding IsLinear, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel
                        Margin="0,0,0,6"
                        Orientation="Horizontal"
                        Visibility="{Binding IsNumbers, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="{Binding BigFontSize}"
                            FontWeight="Bold"
                            Foreground="{Binding PercentBrush}"
                            Text="{Binding PercentLabel}" />
                        <TextBlock
                            Margin="6,0,0,4"
                            VerticalAlignment="Bottom"
                            FontSize="12"
                            Foreground="{Binding MutedBrush}"
                            Text="{Binding PercentCaption}" />
                    </StackPanel>

                    <TextBlock
                        FontSize="12"
                        FontWeight="{Binding CountdownWeight}"
                        Foreground="{Binding CountdownBrush}"
                        Text="{Binding CountdownLabel}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{Binding MutedBrush}"
                        Text="{Binding ShortResetLabel}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding ShowDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <DockPanel
                        Margin="0,4,0,0"
                        Visibility="{Binding ShowPace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse
                            Width="6"
                            Height="6"
                            Margin="0,5,6,0"
                            VerticalAlignment="Top"
                            Fill="{Binding PaceBrush}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{Binding MutedBrush}"
                            Text="{Binding PaceLabel}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProviderCardTemplate" DataType="{x:Type local:ProviderCardViewModel}">
            <Border
                Margin="{Binding CardMargin}"
                Padding="{Binding CardPadding}"
                Style="{StaticResource ProviderCardBorderStyle}">
                <DockPanel>
                    <Grid
                        Width="{Binding HeaderWidth}"
                        Margin="{Binding HeaderMargin}"
                        VerticalAlignment="Center"
                        DockPanel.Dock="{Binding HeaderDock}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Fill="{Binding ProviderBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBox
                                FontSize="{Binding NameFontSize}"
                                FontWeight="SemiBold"
                                MaxLength="40"
                                Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                ToolTip="{local:Tr RenameAccountTip}"
                                Visibility="{Binding IsCardsView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock
                                FontSize="{Binding NameFontSize}"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DisplayName}"
                                Visibility="{Binding IsNameReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{Binding Subtitle}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding ShowSubtitle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <!-- Codex reset credits available in ChatGPT (read-only). -->
                            <Border
                                Margin="8,0,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{Binding ResetChipBackground}"
                                CornerRadius="12"
                                ToolTip="{Binding ResetCreditsTooltip}"
                                Visibility="{Binding HasResetCredits, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path
                                                Data="M20,12 A8,8 0 1 1 17.66,6.34 M20,4 V9 H15"
                                                Stroke="{Binding ResetChipForeground}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="2.6" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{Binding ResetChipForeground}"
                                        Text="{Binding ResetCreditsLabel}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Margin="8,0,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{Binding PillBackground}"
                                CornerRadius="12"
                                Visibility="{Binding ShowPill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{Binding PillForeground}"
                                    Text="{Binding PillText}" />
                            </Border>
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Click="CopyLoginCommand_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTip="{local:Tr CopyLoginTip}"
                            Visibility="{Binding RequiresLogin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M9,9 H20 V20 H9 Z M5,15 V6 A2,2 0 0 1 7,4 H16" Style="{StaticResource IconPathStyle}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock FontSize="12" Text="{local:Tr CopyLogin}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl
                            Margin="{Binding WindowsMargin}"
                            ItemTemplate="{StaticResource RateWindowTemplate}"
                            ItemsSource="{Binding VisibleWindows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding WindowColumns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border
        Background="{DynamicResource AppBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Border.LayoutTransform>

        <DockPanel LastChildFill="True">
            <Grid
                Margin="16,12,12,12"
                Background="Transparent"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="30"
                    Height="30"
                    Margin="0,0,10,0"
                    Padding="7,0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="8">
                    <StackPanel VerticalAlignment="Center">
                        <Border Height="5" Background="{DynamicResource AccentInkBrush}" CornerRadius="2.5" />
                        <Border
                            Width="10"
                            Height="3"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentInkBrush}"
                            CornerRadius="1.5"
                            Opacity="0.8" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="Bold" Text="CodexBar" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding Status}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border Margin="8,0,6,0" VerticalAlignment="Center" Style="{StaticResource SegmentHostStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="{local:Tr ViewCardsName}"
                                Command="{Binding SelectViewCommand.Cards}"
                                Style="{StaticResource ViewButtonStyle}"
                                Tag="{Binding IsCardsView}"
                                ToolTip="{local:Tr ViewCards}">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4,4 H20 V11 H4 Z M4,13 H20 V20 H4 Z" Style="{StaticResource IconPathStyle}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button
                                Margin="2,0"
                                AutomationProperties.Name="{local:Tr ViewSummaryName}"
                                Command="{Binding SelectViewCommand.Summary}"
                                Style="{StaticResource ViewButtonStyle}"
                                Tag="{Binding IsSummaryView}"
                                ToolTip="{local:Tr ViewSummary}">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4,7 H20 M4,12 H20 M4,17 H20" Style="{StaticResource IconPathStyle}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button
                                AutomationProperties.Name="{local:Tr ViewMiniName}"
                                Command="{Binding SelectViewCommand.Mini}"
                                Style="{StaticResource ViewButtonStyle}"
                                Tag="{Binding IsMiniView}"
                                ToolTip="{local:Tr ViewMini}">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4,4 H11 V11 H4 Z M13,4 H20 V11 H13 Z M4,13 H11 V20 H4 Z M13,13 H20 V20 H13 Z" Style="{StaticResource IconPathStyle}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ToggleButton
                        AutomationProperties.Name="{local:Tr AlwaysOnTop}"
                        IsChecked="{Binding IsAlwaysOnTop}"
                        Style="{StaticResource IconToggleStyle}"
                        ToolTip="{local:Tr AlwaysOnTop}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,16 V21 M9,3 H15 L14,9 L17,12 V16 H7 V12 L10,9 Z" Style="{StaticResource IconPathStyle}" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <Button
                        AutomationProperties.Name="{local:Tr Customize}"
                        Click="CustomizeButton_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{local:Tr Customize}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4,6 H13 M17,6 H20 M4,12 H7 M11,12 H20 M4,18 H15 M19,18 H20 M15,4 A2,2 0 1 1 15,8 A2,2 0 1 1 15,4 M9,10 A2,2 0 1 1 9,14 A2,2 0 1 1 9,10 M17,16 A2,2 0 1 1 17,20 A2,2 0 1 1 17,16" Style="{StaticResource IconPathStyle}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button
                        AutomationProperties.Name="{local:Tr MinimizeName}"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{local:Tr Minimize}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6,12 H18" Style="{StaticResource IconPathStyle}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button
                        AutomationProperties.Name="{local:Tr HideName}"
                        Click="HideButton_Click"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{local:Tr Hide}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconPathStyle}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <DockPanel Margin="16,2,12,12" DockPanel.Dock="Bottom">
                <Button
                    MinWidth="132"
                    Margin="12,0,0,0"
                    Padding="14,8"
                    AutomationProperties.Name="{local:Tr RefreshNow}"
                    Click="RefreshButton_Click"
                    DockPanel.Dock="Right"
                    IsEnabled="{Binding CanRefresh}"
                    Style="{StaticResource RefreshButtonStyle}"
                    ToolTip="{local:Tr RefreshTip}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform />
                            </Viewbox.RenderTransform>
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="RefreshSpin">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            RepeatBehavior="Forever"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0"
                                                            To="360"
                                                            Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="RefreshSpin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <Canvas Width="24" Height="24">
                                <Path Data="M20,12 A8,8 0 1 1 17.66,6.34 M20,4 V9 H15" Style="{StaticResource IconPathStyle}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding RefreshButtonLabel}" />
                    </StackPanel>
                </Button>
                <Ellipse
                    Width="7"
                    Height="7"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Fill="{Binding FooterDotBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding FooterText}"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Border
                Margin="12,0,12,10"
                Padding="12,8,8,8"
                Background="{DynamicResource AccentMutedBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="10"
                DockPanel.Dock="Bottom"
                Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button
                        Margin="10,0,0,0"
                        Padding="12,4"
                        Click="InstallUpdateButton_Click"
                        Content="{local:Tr Restart}"
                        DockPanel.Dock="Right"
                        FontSize="12"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTip="{local:Tr RestartTip}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding UpdateText}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- Scrolls only when the cards do not fit on screen (small displays, large scale). -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
                </ScrollViewer.Resources>
                <ItemsControl
                    Background="Transparent"
                    ItemTemplate="{StaticResource ProviderCardTemplate}"
                    ItemsSource="{Binding Providers}"
                    MouseLeftButtonDown="CardList_MouseLeftButtonDown">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Margin" Value="12,0,12,12" />
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMiniView}" Value="True">
                                    <Setter Property="Margin" Value="8,0,8,8" />
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
