<Window
    x:Class="CodexBar.Windows.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexBar"
    Width="440"
    MinHeight="220"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/CodexBar.Windows.Tray;component/Assets/CodexBar.ico"
    ResizeMode="CanMinimize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    Topmost="{Binding IsAlwaysOnTop}"
    WindowStartupLocation="Manual"
    PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
    PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
    PreviewMouseMove="Window_PreviewMouseMove"
    WindowStyle="None">
    <Border
        Background="{StaticResource AppBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.LayoutTransform>
            <ScaleTransform
                ScaleX="{Binding UiScale}"
                ScaleY="{Binding UiScale}" />
        </Border.LayoutTransform>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="22"
                Opacity="0.45"
                ShadowDepth="6"
                Color="#000000" />
        </Border.Effect>

        <DockPanel LastChildFill="True">
            <Grid
                DockPanel.Dock="Top"
                Height="52"
                Margin="12,3,7,0"
                Background="Transparent"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Width="30"
                    Height="30"
                    Margin="0,0,8,0"
                    Source="/CodexBar.Windows.Tray;component/Assets/CodexBarIcon.png"
                    Stretch="Uniform" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="CodexBar" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding Status}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="36"
                        Height="30"
                        Margin="0,0,6,0"
                        Padding="0"
                        Click="SettingsButton_Click"
                        Content="Aa"
                        ToolTip="Appearance settings" />
                    <Button
                        Margin="0,0,6,0"
                        Padding="9,5"
                        Click="CompactButton_Click"
                        Content="{Binding CompactButtonLabel}"
                        ToolTip="Toggle cards or landscape summary" />
                    <ToggleButton
                        Width="34"
                        Height="30"
                        Margin="0,0,6,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        IsChecked="{Binding IsAlwaysOnTop}"
                        ToolTip="Always on top">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Text="◆" />
                    </ToggleButton>
                    <Button
                        Width="34"
                        Height="30"
                        Margin="0,0,6,0"
                        Padding="0"
                        Click="MinimizeButton_Click"
                        Content="—"
                        ToolTip="Minimize to taskbar" />
                    <Button
                        Width="34"
                        Height="30"
                        Padding="0"
                        Click="HideButton_Click"
                        Content="×"
                        ToolTip="Hide to notification area" />
                </StackPanel>
            </Grid>

            <Border
                DockPanel.Dock="Top"
                Margin="12,0,12,5"
                Padding="10,7"
                Background="#101216"
                BorderBrush="{StaticResource AccentMutedBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="Interface size" />
                        <TextBlock
                            Margin="0,1,0,0"
                            FontSize="9"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Saved automatically" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="28"
                        Padding="0"
                        Click="DecreaseUiScaleButton_Click"
                        Content="A−"
                        IsEnabled="{Binding CanDecreaseUiScale}"
                        ToolTip="Decrease interface size" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentBrush}"
                        Text="{Binding UiScaleLabel}" />
                    <Button
                        Grid.Column="3"
                        Width="32"
                        Height="28"
                        Padding="0"
                        Click="IncreaseUiScaleButton_Click"
                        Content="A+"
                        IsEnabled="{Binding CanIncreaseUiScale}"
                        ToolTip="Increase interface size" />
                    <Button
                        Grid.Column="4"
                        Height="28"
                        Margin="7,0,0,0"
                        Padding="8,0"
                        Click="ResetUiScaleButton_Click"
                        Content="100%"
                        ToolTip="Reset interface size" />
                </Grid>
            </Border>

            <Border
                DockPanel.Dock="Bottom"
                Margin="12,5,12,12"
                Padding="10,7"
                Background="#101216"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource AccentBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Refreshes every 5 minutes" />
                    </StackPanel>
                    <Button
                        DockPanel.Dock="Right"
                        MinWidth="72"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        BorderBrush="{StaticResource AccentMutedBrush}"
                        Click="RefreshButton_Click"
                        Content="Refresh"
                        Foreground="{StaticResource AccentBrush}"
                        IsEnabled="{Binding CanRefresh}" />
                </DockPanel>
            </Border>

            <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="12,2,12,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                    <Setter Property="Margin" Value="6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                MaxLength="40"
                                                Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                                ToolTip="Click to rename this account" />
                                            <Button
                                                Grid.Column="1"
                                                Height="24"
                                                Margin="8,0,0,0"
                                                Padding="7,2"
                                                Click="CopyLoginCommand_Click"
                                                Content="Copy login"
                                                ToolTip="Copy the login command for this account"
                                                Visibility="{Binding RequiresLogin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Border
                                                Grid.Column="2"
                                                Margin="6,0,0,0"
                                                Padding="7,2"
                                                Background="#22262C"
                                                CornerRadius="8">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Text="{Binding Identity}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            Foreground="#FF7777"
                                            Text="{Binding ErrorMessage}"
                                            TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding Windows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                Text="{Binding Label}" />
                                                            <ProgressBar
                                                                Grid.Column="1"
                                                                Height="6"
                                                                Margin="6,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Maximum="100"
                                                                Value="{Binding UsedPercent, Mode=OneWay}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                Text="{Binding RemainingLabel}" />
                                                        <DockPanel
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="6,1,0,0"
                                                            LastChildFill="False">
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                Text="{Binding CountdownLabel}" />
                                                            <TextBlock
                                                                DockPanel.Dock="Right"
                                                                Margin="8,0,0,0"
                                                                FontSize="9"
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                Text="{Binding ResetDateLabel}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip="{Binding ResetDateLabel}" />
                                                        </DockPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,2"
                                    Padding="9,6"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding DisplayName}" />
                                        <Grid
                                            Grid.Column="1"
                                            Margin="6,0"
                                            VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar
                                                Grid.Column="0"
                                                Height="7"
                                                Margin="0,0,5,0"
                                                Maximum="100"
                                                Value="{Binding SessionWindow.UsedPercent, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource AccentBrush}"
                                                Text="{Binding SessionWindow.UsedPercentLabel}" />
                                            <TextBlock
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                Foreground="#FF7777"
                                                Text="{Binding ErrorMessage}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Foreground="{StaticResource AccentBrush}"
                                            TextAlignment="Right"
                                            Text="{Binding SessionWindow.CompactCountdownLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="3"
                                            Height="24"
                                            Margin="8,0,0,0"
                                            Padding="7,2"
                                            Click="CopyLoginCommand_Click"
                                            Content="Login"
                                            ToolTip="Copy the login command for this account"
                                            Visibility="{Binding RequiresLogin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Grid>
        </DockPanel>
    </Border>
</Window>
