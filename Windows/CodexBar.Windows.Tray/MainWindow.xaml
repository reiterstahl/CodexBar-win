<Window
    x:Class="CodexBar.Windows.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexBar"
    Width="390"
    MinHeight="280"
    MaxHeight="680"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="ToolWindow">
    <Border Padding="18">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="CodexBar" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                        Text="{Binding Status}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    MinWidth="76"
                    Padding="12,6"
                    Click="RefreshButton_Click"
                    Content="Refresh"
                    IsEnabled="{Binding CanRefresh}" />
            </Grid>

            <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Padding="14"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            DockPanel.Dock="Right"
                                            Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                            Text="{Binding Identity}" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="IndianRed"
                                        TextWrapping="Wrap"
                                        Text="{Binding ErrorMessage}" />
                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Windows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,6,0,2">
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock
                                                            DockPanel.Dock="Right"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding RemainingLabel}" />
                                                    </DockPanel>
                                                    <ProgressBar
                                                        Height="7"
                                                        Maximum="100"
                                                        Value="{Binding UsedPercent}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                        Text="{Binding ResetLabel}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
