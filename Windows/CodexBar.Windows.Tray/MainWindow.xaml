<Window
    x:Class="CodexBar.Windows.Tray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexBar"
    Width="440"
    MinHeight="260"
    MaxHeight="720"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/CodexBar.Windows.Tray;component/Assets/CodexBar.ico"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="{Binding IsAlwaysOnTop}"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Border
        Background="{StaticResource AppBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="22"
                Opacity="0.45"
                ShadowDepth="6"
                Color="#000000" />
        </Border.Effect>

        <DockPanel LastChildFill="True">
            <Grid
                DockPanel.Dock="Top"
                Height="58"
                Margin="14,4,8,0"
                Background="Transparent"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Width="34"
                    Height="34"
                    Margin="0,0,10,0"
                    Source="/CodexBar.Windows.Tray;component/Assets/CodexBarIcon.png"
                    Stretch="Uniform" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="CodexBar" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="{Binding Status}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Padding="9,5"
                        Click="CompactButton_Click"
                        Content="{Binding CompactButtonLabel}"
                        ToolTip="Toggle cards or landscape summary" />
                    <ToggleButton
                        Width="34"
                        Height="30"
                        Margin="0,0,6,0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        IsChecked="{Binding IsAlwaysOnTop}"
                        ToolTip="Always on top">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Text="◆" />
                    </ToggleButton>
                    <Button
                        Width="34"
                        Height="30"
                        Margin="0,0,6,0"
                        Padding="0"
                        Click="MinimizeButton_Click"
                        Content="—"
                        ToolTip="Minimize to notification area" />
                    <Button
                        Width="34"
                        Height="30"
                        Padding="0"
                        Click="HideButton_Click"
                        Content="×"
                        ToolTip="Hide to notification area" />
                </StackPanel>
            </Grid>

            <Border
                DockPanel.Dock="Bottom"
                Margin="14,6,14,14"
                Padding="12,9"
                Background="#101216"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource AccentBrush}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Names are editable · refreshes every 5 minutes" />
                    </StackPanel>
                    <Button
                        DockPanel.Dock="Right"
                        MinWidth="78"
                        Margin="12,0,0,0"
                        Padding="11,5"
                        BorderBrush="{StaticResource AccentMutedBrush}"
                        Click="RefreshButton_Click"
                        Content="Refresh"
                        Foreground="{StaticResource AccentBrush}"
                        IsEnabled="{Binding CanRefresh}" />
                </DockPanel>
            </Border>

            <ScrollViewer
                Margin="14,4,14,0"
                MaxHeight="570"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                MaxLength="40"
                                                Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                                ToolTip="Click to rename this account" />
                                            <Border
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Padding="8,3"
                                                Background="#22262C"
                                                CornerRadius="8">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Text="{Binding Identity}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            Foreground="#FF7777"
                                            Text="{Binding ErrorMessage}"
                                            TextWrapping="Wrap" />

                                        <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Windows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,7,0,2">
                                                        <DockPanel Margin="0,0,0,5">
                                                            <TextBlock
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                Text="{Binding Label}" />
                                                            <TextBlock
                                                                DockPanel.Dock="Right"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                Text="{Binding RemainingLabel}" />
                                                        </DockPanel>
                                                        <ProgressBar
                                                            Maximum="100"
                                                            Value="{Binding UsedPercent}" />
                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            FontSize="10"
                                                            Foreground="{StaticResource SecondaryTextBrush}"
                                                            Text="{Binding ResetLabel}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,7"
                                    Padding="12,10"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            MaxLength="40"
                                            Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="Click to rename this account" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="16,0"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="{Binding Identity}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource AccentBrush}"
                                            Text="{Binding CompactSummary}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
