<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CodexBar.ico</ApplicationIcon>
    <!-- The UI is Spanish; skip the other localized WPF/WinForms runtime resources. -->
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexBar.EngineClient\CodexBar.EngineClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CodexBar.ico" />
    <Resource Include="Assets\CodexBarIcon.png" />
  </ItemGroup>
</Project>
