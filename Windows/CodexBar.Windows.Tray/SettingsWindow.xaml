<Window
    x:Class="CodexBar.Windows.Tray.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CodexBar.Windows.Tray"
    Title="{local:Tr SettingsWindowTitle}"
    Width="500"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource UiFont}"
    Foreground="{DynamicResource PrimaryTextBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Window.Resources>
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="ToolTip" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse
                                x:Name="SwatchRing"
                                Stroke="Transparent"
                                StrokeThickness="2" />
                            <Ellipse
                                Margin="4"
                                Fill="{Binding Swatch}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchRing" Property="Stroke" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SwatchRing" Property="Stroke" Value="{DynamicResource PrimaryTextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPickButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PickBorder"
                            Padding="4,4,10,4"
                            Background="Transparent"
                            CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickBorder" Property="Background" Value="{DynamicResource RaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="SegmentPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type local:OptionViewModel}">
            <Button Style="{StaticResource SegmentButtonStyle}" />
        </DataTemplate>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border
        Background="{DynamicResource AppBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Border.LayoutTransform>

        <DockPanel>
            <Border
                Padding="20,14,12,14"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{local:Tr CloseCustomizationName}"
                        Click="CloseButton_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{local:Tr Close}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconPathStyle}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Text="{local:Tr Customize}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{local:Tr SettingsSubtitle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border
                Padding="20,12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                DockPanel.Dock="Bottom">
                <DockPanel>
                    <Button
                        Command="{Binding Customization.ResetCommand}"
                        Content="{local:Tr Reset}"
                        DockPanel.Dock="Right"
                        FontSize="13"
                        ToolTip="{local:Tr ResetTip}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding Customization.FooterText}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="20,16,20,18">
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{local:Tr SectionTheme}" />
                    <ItemsControl ItemsSource="{Binding Customization.Themes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:OptionViewModel}">
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="5"
                                    AutomationProperties.Name="{Binding Label}"
                                    Style="{StaticResource TileButtonStyle}">
                                    <StackPanel>
                                        <Border
                                            Height="42"
                                            Padding="7,0"
                                            Background="{Binding PreviewBackground}"
                                            BorderBrush="{Binding PreviewFrame}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel VerticalAlignment="Center">
                                                <Border
                                                    Width="32"
                                                    Height="5"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding PreviewAccent}"
                                                    CornerRadius="2.5" />
                                                <Border
                                                    Height="5"
                                                    Margin="0,5,0,0"
                                                    Background="{Binding PreviewTrack}"
                                                    CornerRadius="2.5" />
                                                <Border
                                                    Width="20"
                                                    Height="3"
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding PreviewText}"
                                                    CornerRadius="1.5"
                                                    Opacity="0.6" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock
                                            Margin="1,6,0,0"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Text="{Binding Label}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,18,0,10"
                        Style="{StaticResource SectionLabelStyle}"
                        Text="{local:Tr SectionAccent}" />
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Customization.Accents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:OptionViewModel}">
                                    <Button Margin="0,0,4,0" Style="{StaticResource SwatchButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border
                            Width="1"
                            Height="24"
                            Margin="6,0,10,0"
                            Background="{DynamicResource BorderBrush}" />
                        <Button
                            AutomationProperties.Name="{local:Tr PickColorName}"
                            Click="PickAccentButton_Click"
                            Style="{StaticResource ColorPickButtonStyle}"
                            ToolTip="{local:Tr PickColorTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="26"
                                    Height="26"
                                    Fill="{DynamicResource CustomAccentBrush}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeDashArray="2 2"
                                    StrokeThickness="2" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{local:Tr CustomColor}" />
                            </StackPanel>
                        </Button>
                        <TextBox
                            x:Name="AccentHexBox"
                            Width="72"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr AccentHexName}"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            KeyDown="HexBox_KeyDown"
                            MaxLength="7"
                            Text="{Binding Customization.AccentHex, UpdateSourceTrigger=LostFocus}"
                            ToolTip="{local:Tr AccentHexTip}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,18,0,10"
                        Style="{StaticResource SectionLabelStyle}"
                        Text="{local:Tr SectionChart}" />
                    <UniformGrid Rows="1">
                        <Button
                            Margin="0,0,8,0"
                            Padding="6,10,6,8"
                            DataContext="{Binding Customization.Charts[0]}"
                            Style="{StaticResource TileButtonStyle}">
                            <StackPanel>
                                <StackPanel Width="56" Height="40" VerticalAlignment="Center">
                                    <local:UsageMeter
                                        Height="6"
                                        Margin="0,11,0,0"
                                        FillBrush="{DynamicResource AccentBrush}"
                                        Thickness="6"
                                        TrackBrush="{DynamicResource TrackBrush}"
                                        Value="70" />
                                    <local:UsageMeter
                                        Height="6"
                                        Margin="0,6,0,0"
                                        FillBrush="{DynamicResource AccentBrush}"
                                        Thickness="6"
                                        TrackBrush="{DynamicResource TrackBrush}"
                                        Value="38" />
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,0"
                            Padding="6,10,6,8"
                            DataContext="{Binding Customization.Charts[1]}"
                            Style="{StaticResource TileButtonStyle}">
                            <StackPanel>
                                <Grid Height="40">
                                    <local:UsageMeter
                                        Width="38"
                                        Height="38"
                                        FillBrush="{DynamicResource AccentBrush}"
                                        Kind="Ring"
                                        Thickness="6"
                                        TrackBrush="{DynamicResource TrackBrush}"
                                        Value="65" />
                                </Grid>
                                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,0"
                            Padding="6,10,6,8"
                            DataContext="{Binding Customization.Charts[2]}"
                            Style="{StaticResource TileButtonStyle}">
                            <StackPanel>
                                <Grid Height="40">
                                    <local:UsageMeter
                                        Width="52"
                                        Height="30"
                                        FillBrush="{DynamicResource AccentBrush}"
                                        Kind="Gauge"
                                        Thickness="7"
                                        TrackBrush="{DynamicResource TrackBrush}"
                                        Value="65" />
                                </Grid>
                                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,0"
                            Padding="6,10,6,8"
                            DataContext="{Binding Customization.Charts[3]}"
                            Style="{StaticResource TileButtonStyle}">
                            <StackPanel>
                                <Grid Height="40">
                                    <local:UsageMeter
                                        Width="56"
                                        Height="14"
                                        FillBrush="{DynamicResource AccentBrush}"
                                        Kind="Blocks"
                                        Segments="8"
                                        Thickness="8"
                                        TrackBrush="{DynamicResource TrackBrush}"
                                        Value="62.5" />
                                </Grid>
                                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Padding="6,10,6,8"
                            DataContext="{Binding Customization.Charts[4]}"
                            Style="{StaticResource TileButtonStyle}">
                            <StackPanel>
                                <Grid Height="40">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource AccentTextBrush}"
                                        Text="62%" />
                                </Grid>
                                <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{local:Tr SectionChartColors}" />
                            <Border Style="{StaticResource SegmentHostStyle}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource SegmentTemplate}"
                                    ItemsPanel="{StaticResource SegmentPanel}"
                                    ItemsSource="{Binding Customization.ColorModes}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{local:Tr SectionPercent}" />
                            <Border Style="{StaticResource SegmentHostStyle}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource SegmentTemplate}"
                                    ItemsPanel="{StaticResource SegmentPanel}"
                                    ItemsSource="{Binding Customization.PercentModes}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding Customization.ShowProviderColors, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button
                            Margin="0,0,16,0"
                            AutomationProperties.Name="{local:Tr CodexColorName}"
                            Click="PickProviderColorButton_Click"
                            Style="{StaticResource ColorPickButtonStyle}"
                            Tag="codex">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="26" Height="26" Fill="{DynamicResource CodexBrush}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Codex" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="{local:Tr ClaudeColorName}"
                            Click="PickProviderColorButton_Click"
                            Style="{StaticResource ColorPickButtonStyle}"
                            Tag="claude">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="26" Height="26" Fill="{DynamicResource ClaudeBrush}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="Claude Code" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{local:Tr SectionView}" />
                            <Border Style="{StaticResource SegmentHostStyle}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource SegmentTemplate}"
                                    ItemsPanel="{StaticResource SegmentPanel}"
                                    ItemsSource="{Binding Customization.Views}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{local:Tr SectionDensity}" />
                            <Border Style="{StaticResource SegmentHostStyle}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource SegmentTemplate}"
                                    ItemsPanel="{StaticResource SegmentPanel}"
                                    ItemsSource="{Binding Customization.Densities}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{local:Tr SectionLanguage}" />
                            <Border Style="{StaticResource SegmentHostStyle}">
                                <ItemsControl
                                    ItemTemplate="{StaticResource SegmentTemplate}"
                                    ItemsPanel="{StaticResource SegmentPanel}"
                                    ItemsSource="{Binding Customization.Languages}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,20,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SettingTitleStyle}"
                            Text="{local:Tr InterfaceSize}" />
                        <TextBlock
                            Width="44"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentTextBrush}"
                            Text="{Binding UiScalePercent, StringFormat='{}{0:0}%'}"
                            TextAlignment="Right" />
                        <Slider
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr InterfaceSize}"
                            IsSnapToTickEnabled="True"
                            LargeChange="10"
                            Maximum="160"
                            Minimum="80"
                            SmallChange="10"
                            TickFrequency="10"
                            Value="{Binding UiScalePercent}" />
                    </DockPanel>

                    <TextBlock
                        Margin="0,20,0,6"
                        Style="{StaticResource SectionLabelStyle}"
                        Text="{local:Tr SectionBehavior}" />
                    <DockPanel Margin="0,4">
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr PaceMarker}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding Customization.ShowPace}"
                            Style="{StaticResource SwitchStyle}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="{local:Tr PaceMarker}" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="{local:Tr PaceMarkerHint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr AvailableFirst}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding Customization.AvailableFirst}"
                            Style="{StaticResource SwitchStyle}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="{local:Tr AvailableFirst}" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="{local:Tr AvailableFirstHint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr NotifyRecovery}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding Customization.NotifyOnRecovery}"
                            Style="{StaticResource SwitchStyle}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="{local:Tr NotifyRecovery}" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="{local:Tr NotifyRecoveryHint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr DynamicIcon}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding Customization.DynamicTrayIcon}"
                            Style="{StaticResource SwitchStyle}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="{local:Tr DynamicIcon}" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="{local:Tr DynamicIconHint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr StartWithWindows}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding Customization.StartWithWindows}"
                            Style="{StaticResource SwitchStyle}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="{local:Tr StartWithWindows}" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="{local:Tr StartWithWindowsHint}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Tr AlwaysOnTop}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding IsAlwaysOnTop}"
                            Style="{StaticResource SwitchStyle}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SettingTitleStyle}" Text="{local:Tr AlwaysOnTop}" />
                            <TextBlock Style="{StaticResource SettingHintStyle}" Text="{local:Tr AlwaysOnTopHint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
